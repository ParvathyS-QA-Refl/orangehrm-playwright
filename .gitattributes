# Tells Git how to treat line endings, so files look the same on Windows and on CI (Linux).
# Text files are stored with LF line endings in the repository and checked out with LF.
* text=auto eol=lf

# Windows-only scripts keep Windows (CRLF) line endings
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never change line endings or try to show text diffs
*.png  binary
*.jpg  binary
*.zip  binary
*.webm binary
*.jpeg binary
*.gif  binary